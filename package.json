{
  "name": "@openflow/chart",
  "version": "0.1.0-rc.4",
  "private": true,
  "author": "Ryan Gavin",
  "license": "MIT",
  "type": "module",
  "description": "chart[flow]: what the band reads off a phone \u2014 a read-only client of the bridge, and the only open[flow] module that binds the LAN.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openflowfm/chart.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && node --disable-warning=ExperimentalWarning tools/server.ts",
    "start": "node dist/server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning tools/dev.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning tools/server.ts --watch",
    "dev:ui": "vite --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@openflow/core": "github:openflowfm/core#685db6fd1a8ba77bb8e575c66935a11fb56acce9",
    "@openflow/protocol": "github:openflowfm/protocol#918e52b61afcc9945d433a445557a3043e532af1",
    "@openflow/widgets": "git+https://github.com/openflowfm/widgets.git#dc356455e561c7eb9dce337a1e6b6810a5251fcb",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "5.0.0"
  }
}
